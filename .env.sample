# =============================================================================
# Emly AI Assistant — environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values marked CHANGE_ME. Anything
# left commented falls back to the default shown.
#
#   cp .env.sample .env
#   docker compose up
# =============================================================================


# ----- Process / runtime knobs -----------------------------------------------
MODE=dev
HOST=0.0.0.0
PORT=8080
# WEB_CONCURRENCY > 1 is rejected at boot when QDRANT_URL is unset (embedded
# Qdrant doesn't tolerate multi-worker). Leave at 1 for the default compose
# stack which uses a server-mode Qdrant on the colocated container.
WEB_CONCURRENCY=1

# DATA_DIR is the *in-container* path the app writes to. Don't change this
# unless you know why — the Dockerfile pre-warms the embedding cache here.
DATA_DIR=/app/data

# Host path that gets bind-mounted onto /app/data inside the app container.
# This is what makes uploads, the embedding cache, the JWT signing key, and
# (if DATABASE_URL points at sqlite) the SQLite file persist across
# `docker compose down` and easy to back up. Use an absolute path for
# clarity in production. On Linux the host directory must be writable by
# uid 10001 (the container's `emly` user) — see README.
DATA_DIR_HOST=./data

# Host paths bind-mounted into the postgres and qdrant containers. Defaults
# put both alongside DATA_DIR_HOST so the entire stack's persistent state
# lives in one place. On Linux, the postgres path needs to be writable by
# the postgres uid (typically 999); qdrant by uid 1000.
POSTGRES_DATA_HOST=./data/postgres
QDRANT_DATA_HOST=./data/qdrant


# ----- Database --------------------------------------------------------------
# When using compose, points at the colocated Postgres service.
# For SQLite (single-process dev only): DATABASE_URL=sqlite:///app/data/emlygenai_app.db
DATABASE_URL=postgresql://emly:emlypassword@postgres:5432/emly

# Used by the postgres compose service (matched by DATABASE_URL above).
POSTGRES_USER=emly
POSTGRES_PASSWORD=emlypassword
POSTGRES_DB=emly


# ----- Vector DB (Qdrant) ----------------------------------------------------
# Compose runs Qdrant as a service; this URL points at it. Unset to fall back
# to embedded mode under DATA_DIR/qdrant_db (single-worker only).
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bots


# ----- LLM provider ----------------------------------------------------------
# Per-bot LLM provider, model, and API key live in `bots.config_json` and
# `bots.api_key_encrypted` — set them through the admin UI's Config tab or
# via `PUT /api/admin/bots/{slug}/api-key`. There are no process-wide
# provider env vars anymore.
#
# The two settings below remain process-wide as deployment-level fallbacks
# applied only when a bot's config_json doesn't override them.
MODEL=google/gemma-4-26b-a4b-it:free
TEMPERATURE=0.7
MAX_TOKENS=1024

# OPENAI_API_KEY is used in two places:
#   1. As the embedding-time key when EMBEDDING_PROVIDER=openai (below).
#   2. As a deployment-wide fallback for bots that don't have a per-bot
#      api_key set yet. New bots should always use the per-bot api-key
#      endpoint instead.
OPENAI_API_KEY=sk-or-hghghjf
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=


# ----- Embeddings & RAG ------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
RAG_EMBEDDING_MODEL=Alibaba-NLP/gte-base-en-v1.5
SENTENCE_TRANSFORMERS_HOME=/app/data/models/embedding

RAG_TOP_K=5
CHUNK_SIZE=2048
CHUNK_OVERLAP=256

# Set to "true" to enable CrossEncoder re-ranking on retrieved chunks.
ENABLE_RAG_HYBRID_SEARCH=false
RE_RANKING_MODEL=ms-marco-TinyBERT-L-2-v2


# ----- Admin auth ------------------------------------------------------------
# Bootstraps the first admin if admin_user is empty. ADMIN_PASSWORD is
# optional; without it a random password is generated and printed to logs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# HS256 signing key for admin JWTs (12h TTL). Auto-generated to
# {DATA_DIR}/.admin_jwt_secret on first boot if unset.
ADMIN_JWT_SECRET=

# Fernet key used to encrypt per-bot LLM API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Auto-generated to {DATA_DIR}/.bot_secrets_key if unset.
BOT_SECRETS_KEY=

# URL admins land on when they click an invite link.
PUBLIC_BASE_URL=http://localhost:8080


# ----- Email (SMTP for invite + summary mails) -------------------------------
EMAIL_SERVER=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASSWORD=
EMAIL_FROM=noreply@emlylabs.com
EMAIL_DELAY_IN_MINUTES=5


# ----- Conversation defaults -------------------------------------------------
LATEST_N_MESSAGES=3
MAX_MESSAGE_CONTEXT=5
DEFAULT_MESSAGE=Unfortunately, I cannot find this information. Please try a different query.
TIMEZONE=Asia/Kolkata
USE_EMLY_SUMMARIZE=true


# ----- Channel integrations (optional) ---------------------------------------
GOOGLE_CHAT_BOT_ID=

# Meta WhatsApp Cloud — app-level secret for HMAC verification of inbound
# webhooks. Copy from Meta App → Settings → Basic → App Secret.
# META_APP_SECRET=

# Meta Graph API version. Bump when Meta deprecates the default.
# See https://developers.facebook.com/docs/graph-api/changelog
# META_GRAPH_API_VERSION=v21.0
