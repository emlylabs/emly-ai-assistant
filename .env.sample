# =============================================================================
# Emly AI Assistant — environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values marked CHANGE_ME. Anything
# left commented falls back to the default shown.
#
#   cp .env.sample .env
#   docker compose up
# =============================================================================


# ----- Process / runtime knobs -----------------------------------------------
# MODE=prod (or production/preprod/stage/staging) turns on production-safe
# defaults: API docs off, and APP_BASE_URL becomes required.
MODE=dev
# Interactive API docs (/docs, /redoc, /openapi.json). Defaults to true in
# dev and false when MODE=prod; set explicitly to override.
# ENABLE_API_DOCS=false
HOST=0.0.0.0
PORT=8080
# WEB_CONCURRENCY > 1 is rejected at boot when QDRANT_URL is unset (embedded
# Qdrant doesn't tolerate multi-worker). Leave at 1 for the default compose
# stack which uses a server-mode Qdrant on the colocated container.
WEB_CONCURRENCY=1

# DATA_DIR is the *in-container* path the app writes to. Don't change this
# unless you know why — the Dockerfile pre-warms the embedding cache here.
DATA_DIR=/app/data

# Host path that gets bind-mounted onto /app/data inside the app container.
# This is what makes uploads, the embedding cache, the JWT signing key, and
# (if DATABASE_URL points at sqlite) the SQLite file persist across
# `docker compose down` and easy to back up. Use an absolute path for
# clarity in production. On Linux the host directory must be writable by
# uid 10001 (the container's `emly` user) — see README.
DATA_DIR_HOST=./data

# Host paths bind-mounted into the postgres and qdrant containers. Defaults
# put both alongside DATA_DIR_HOST so the entire stack's persistent state
# lives in one place. On Linux, the postgres path needs to be writable by
# the postgres uid (typically 999); qdrant by uid 1000.
POSTGRES_DATA_HOST=./data/postgres
QDRANT_DATA_HOST=./data/qdrant


# ----- Database --------------------------------------------------------------
# When using compose, points at the colocated Postgres service.
# For SQLite (single-process dev only): DATABASE_URL=sqlite:///app/data/emlygenai_app.db
# docker compose builds DATABASE_URL from the POSTGRES_* values below and
# overrides this line, so it only matters outside compose.
# DATABASE_URL=postgresql://emly:<password>@postgres:5432/emly

# Used by the postgres compose service.
POSTGRES_USER=emly
# Required: `docker compose up` refuses to start while this is empty. It is
# embedded in DATABASE_URL, so use URL-safe characters, e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=emly


# ----- Vector DB (Qdrant) ----------------------------------------------------
# Compose runs Qdrant as a service; this URL points at it. Unset to fall back
# to embedded mode under DATA_DIR/qdrant_db (single-worker only).
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bots


# ----- LLM provider ----------------------------------------------------------
# Per-bot LLM provider, model, and API key live in `bots.config_json` and
# `bots.api_key_encrypted` — set them through the admin UI's Config tab or
# via `PUT /api/admin/bots/{slug}/api-key`. There are no process-wide
# provider env vars anymore.
#
# MODEL, OPENAI_BASE_URL and OPENAI_API_KEY are optional deployment-wide
# defaults for bots that leave the value blank. There is no built-in model
# or endpoint: a bot without one (here or in its own settings) refuses to
# answer until an admin sets it.
MODEL=
TEMPERATURE=0.7
MAX_TOKENS=1024

# OPENAI_API_KEY is used in two places:
#   1. As the embedding-time key when EMBEDDING_PROVIDER=openai (below).
#   2. As a deployment-wide fallback for bots that don't have a per-bot
#      api_key set yet. New bots should always use the per-bot api-key
#      endpoint instead.
OPENAI_API_KEY=
# Include the version path, e.g. https://api.openai.com/v1 or
# https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=


# ----- Embeddings & RAG ------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
RAG_EMBEDDING_MODEL=Alibaba-NLP/gte-base-en-v1.5
SENTENCE_TRANSFORMERS_HOME=/app/data/models/embedding

RAG_TOP_K=5
CHUNK_SIZE=2048
CHUNK_OVERLAP=256

# Set to "true" to enable CrossEncoder re-ranking on retrieved chunks.
ENABLE_RAG_HYBRID_SEARCH=false
RE_RANKING_MODEL=ms-marco-TinyBERT-L-2-v2


# ----- Admin auth ------------------------------------------------------------
# The first superadmin, created on first boot. If AUTH_LOCAL_BOOTSTRAP_PASSWORD
# is empty, a random temporary password is written to
# {DATA_DIR}/bootstrap_password.txt (mode 0600, never logged) and that file is
# deleted after the first sign-in. Either way the first sign-in asks for a new
# password (at least AUTH_LOCAL_MIN_PASSWORD_LENGTH characters, default 12).
AUTH_BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
AUTH_LOCAL_BOOTSTRAP_PASSWORD=

# Fernet key used to encrypt per-bot LLM API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when MODE=prod (the app refuses to start without it). In development
# it is auto-generated to {DATA_DIR}/.bot_secrets_key if unset.
BOT_SECRETS_KEY=
# Rotation: put the new key in BOT_SECRETS_KEY and the old one here
# (comma-separate several), restart, run `python -m scripts.rotate_bot_secrets`,
# and remove this after WIDGET_TOKEN_RENEWAL_WINDOW_SECONDS (30 days).
# BOT_SECRETS_KEY_PREVIOUS=

# URL admins land on when they click an invite link.
PUBLIC_BASE_URL=http://localhost:8080


# ----- Audit log --------------------------------------------------------------
# Days to keep audit rows (daily purge at 03:30 UTC). 0 keeps them forever.
# AUDIT_RETENTION_DAYS=365


# ----- Workspace permissions --------------------------------------------------
# Who can create or duplicate bots: writers (superadmins + owners/admins of
# at least one bot; viewer-only members can't), any (every admin), or
# superadmin (superadmins only).
# BOT_CREATION=writers


# ----- External SSO (OIDC) — see README "External Identity Provider" ---------
# AUTH_LOCAL_ISSUER_ENABLED=false
# AUTH_OIDC_ISSUER=https://your-idp.example.com
# AUTH_OIDC_AUDIENCE=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# Google: set false (Google doesn't issue refresh tokens via offline_access).
# AUTH_OIDC_REQUEST_OFFLINE_ACCESS=true
# Entra ID often omits `email`; read it from these claims in order.
# AUTH_OIDC_EMAIL_CLAIMS=email
# Addresses from fallback claims count as unverified unless this is true.
# AUTH_OIDC_TRUST_EMAIL_UNCONDITIONALLY=false


# ----- Widget tokens -----------------------------------------------------------
# Lifetime of the token /widget/{ref}/init issues, and how long after expiry
# it still proves the visitor's id at /init (so returning visitors keep their
# history). Ids that already have history are never issued without that proof.
# WIDGET_TOKEN_TTL_SECONDS=86400
# WIDGET_TOKEN_RENEWAL_WINDOW_SECONDS=2592000


# ----- Reverse proxy -----------------------------------------------------------
# Proxies trusted to set X-Forwarded-For / X-Forwarded-Proto (comma-separated
# IPs or CIDRs). Client IPs feed rate limits and the audit log, so never '*'.
# Default compose stack (app exposed directly): leave as 127.0.0.1.
# Behind a reverse-proxy container: its IP or the compose subnet, e.g. 172.18.0.0/16.
# Kubernetes: the ingress controller's source range, e.g. the pod CIDR 10.244.0.0/16.
# FORWARDED_ALLOW_IPS=127.0.0.1


# ----- Rate limits ------------------------------------------------------------
# Per-client limits ("<count>/<period>", e.g. 20/minute). Defaults shown.
# Counters live in memory per process. Exceeding one returns 429 + Retry-After.
# AUTH_RATE_WIDGET_INIT=30/minute        # per IP per bot
# AUTH_RATE_WIDGET_CHAT=20/minute        # per IP per bot
# AUTH_RATE_WIDGET_ACTION=20/minute      # per IP per bot (forms, OTP)
# AUTH_RATE_WIDGET_UPLOAD=10/minute      # per IP per bot, actions with files
# AUTH_RATE_OTP_SEND_TARGET=5/10minutes  # per bot + email address
# AUTH_RATE_OTP_SEND_IP=20/hour          # per IP per bot
# AUTH_RATE_OTP_VERIFY=10/10minutes      # per IP per bot
# AUTH_RATE_LOCAL_AUTHORIZE=5/minute     # built-in sign-in, per IP
# AUTH_RATE_LOCAL_TOKEN=10/minute        # built-in sign-in, per IP


# ----- Email (SMTP for invite + summary mails) -------------------------------
# Your own SMTP relay. There is no default: leave EMAIL_SERVER empty and email
# (OTP codes, invites, form alerts) is disabled with a log line at boot.
# Port 465 uses implicit TLS; 587 uses STARTTLS with certificate verification.
EMAIL_SERVER=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_DELAY_IN_MINUTES=5


# ----- Conversation defaults -------------------------------------------------
LATEST_N_MESSAGES=3
MAX_MESSAGE_CONTEXT=5
DEFAULT_MESSAGE=Unfortunately, I cannot find this information. Please try a different query.
TIMEZONE=Asia/Kolkata
USE_EMLY_SUMMARIZE=true


# ----- Channel integrations (optional) ---------------------------------------
GOOGLE_CHAT_BOT_ID=

# Meta WhatsApp Cloud — app-level secret for HMAC verification of inbound
# webhooks. Copy from Meta App → Settings → Basic → App Secret.
# META_APP_SECRET=

# Meta Graph API version. Bump when Meta deprecates the default.
# See https://developers.facebook.com/docs/graph-api/changelog
# META_GRAPH_API_VERSION=v21.0
